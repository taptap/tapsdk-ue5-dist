<?xml version="1.0" encoding="utf-8"?>
<!--
    TapLeaderboard iOS Plugin Configuration

    依赖：TapTapLeaderboardSDK.xcframework（由原生团队交付，统一管理）
    -ObjC 链接标志确保静态归档中 BridgeLeaderboardService 类方法符号被拉入二进制。
-->
<root xmlns:ios="http://schemas.apple.com/AppleTypes">
    <init>
        <log text="TapLeaderboard: iOS UPL loaded"/>
    </init>

    <buildSettings>
        <insert>
            <![CDATA[
GCC_ENABLE_OBJC_EXCEPTIONS = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_CXX_LANGUAGE_STANDARD = gnu++17
ENABLE_BITCODE = NO
IPHONEOS_DEPLOYMENT_TARGET = 15.0
            ]]>
        </insert>
    </buildSettings>

    <buildSettings>
        <insert>
            <![CDATA[
OTHER_LDFLAGS = $(inherited) -ObjC
            ]]>
        </insert>
    </buildSettings>
</root>
